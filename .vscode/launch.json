{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run MoveSmart in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "Start MoveSmart (dev server)"
    },
    {
      "name": "Run MoveSmart in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "Start MoveSmart (dev server)"
    }
  ]
}
