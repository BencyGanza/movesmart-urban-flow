{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install packages",
      "type": "npm",
      "script": "install",
      "problemMatcher": []
    },
    {
      "label": "Start MoveSmart (dev server)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "Build for production",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Check types",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": [
        "$tsc"
      ]
    }
  ]
}
